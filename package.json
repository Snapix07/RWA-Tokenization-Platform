{
  "name": "rwa-tokenization-platform",
  "version": "1.0.0",
  "private": true,
  "description": "RWA Tokenization Platform Monorepo",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "lint": "lint-staged",
    "build:contracts": "cd packages/contracts && forge build",
    "sync:abi": "mkdir -p packages/frontend/src/abis && cp -r packages/contracts/out/* packages/frontend/src/abis/",
    "dev": "npm run build:contracts && npm run sync:abi && cd packages/frontend && npm run dev"
  },
  "devDependencies": {
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "solhint": "^4.5.4"
  },
  "lint-staged": {
    "packages/contracts/**/*.sol": [
      "forge fmt",
      "solhint"
    ],
    "packages/frontend/**/*.{js,ts,jsx,tsx,css,json}": [
      "prettier --write"
    ]
  }
}
