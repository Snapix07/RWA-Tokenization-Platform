{
  "name": "rwa-tokenization-platform",
  "version": "1.0.0",
  "private": true,
  "description": "RWA Tokenization Platform Monorepo",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "lint": "lint-staged"
  },
  "devDependencies": {
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "solhint": "^4.5.4"
  },
  "lint-staged": {
    "packages/contracts/**/*.sol": [
      "forge fmt",
      "solhint"
    ],
    "packages/frontend/**/*.{js,ts,jsx,tsx,css,json}": [
      "prettier --write"
    ]
  }
}
